# Copie para .env e troque os valores (o ./chama.sh start cria um .env com segredos aleatórios).

# --- Banco e autenticação ---
MONGO_USER=chama
MONGO_PASSWORD=troque-esta-senha
# Mínimo de 32 caracteres aleatórios.
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32-chars

# --- Usuário padrão (criado só quando o banco não tem nenhum usuário) ---
# É com ele que se entra a primeira vez e se geram os convites para as outras pessoas.
# No primeiro login o sistema exige trocar esta senha e cadastrar as perguntas de segurança.
# Em branco = o backend gera uma senha aleatória e mostra no log (./chama.sh logs backend).
# Nunca commite a senha real: ela fica só no .env do servidor.
DEFAULT_USER=chama_e_essencia
DEFAULT_USER_PASSWORD=

# --- Gateway nginx (modo standalone: publica estas portas no host) ---
# Portas diferentes de 80/443 para conviver com outros sistemas no mesmo servidor (ex.: Contador de Horas).
HTTP_PORT=8090
HTTPS_PORT=8453
# Certificado autoassinado gerado no primeiro start (troque pelo seu domínio).
NGINX_SELF_SIGNED_CERT_SUBJECT=/CN=localhost
NGINX_SELF_SIGNED_CERT_SAN=DNS:localhost
# true = redireciona HTTP para HTTPS no próprio nginx.
NGINX_FORCE_HTTPS=false

# Réplicas do backend balanceadas pelo nginx.
BACKEND_REPLICAS=1

# --- Traefik (servidor com Traefik na frente, ex.: VPS Hostinger) ---
# true = usa docker-compose.traefik.yml: o nginx não publica portas e o Traefik encaminha o domínio.
TRAEFIK_ENABLED=false
APP_DOMAIN=velas.seudominio.com
TRAEFIK_NETWORK=proxy
TRAEFIK_CERTRESOLVER=letsencrypt
TRAEFIK_ENTRYPOINT_HTTPS=websecure
TRAEFIK_ENTRYPOINT_HTTP=web
